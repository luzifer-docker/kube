{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Standalone Renovate config for mirroring selected registry.k8s.io images.",
  "dependencyDashboard": true,
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^images\\.txt$/"
      ],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "(?:^|\\r?\\n)(?<depName>[^:\\s]+(?:/[^:\\s]+)+):(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
